{
  "name": "cargobajk-sk",
  "main": "worker.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "SHOP_DB",
      "database_name": "cargobajk-orders",
      "database_id": "96d6d5c1-ff9a-412e-80cb-deca2a7e20b2",
      "preview_database_id": "286406c3-7b40-46f3-bf75-1c4966596a3f",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "vars": {
    "SHOP_MODE": "off",
    "INQUIRY_FROM": "cargobajk.sk <hello@vividproduction.sk>",
    "INQUIRY_ALLOWED_ORIGINS": "https://cargobajk.sk,https://www.cargobajk.sk",
    "SHOP_POLICIES_VERSION": "2026-11-09",
    "SHOP_PRODUCTS_JSON": "{\"bike:flex\":{\"verifiedUntil\":\"2026-12-09T23:59:59+01:00\",\"deliveryDays\":21},\"bike:delight\":{\"verifiedUntil\":\"2026-12-09T23:59:59+01:00\",\"deliveryDays\":21},\"bike:flex-dog\":{\"verifiedUntil\":\"2026-12-09T23:59:59+01:00\",\"deliveryDays\":21},\"bike:longtail\":{\"verifiedUntil\":\"2026-12-09T23:59:59+01:00\",\"deliveryDays\":21},\"bike:flex-kindergarten\":{\"verifiedUntil\":\"2026-12-09T23:59:59+01:00\",\"deliveryDays\":21},\"bike:delight-kindergarten\":{\"verifiedUntil\":\"2026-12-09T23:59:59+01:00\",\"deliveryDays\":21},\"bike:classic-kindergarten\":{\"verifiedUntil\":\"2026-12-09T23:59:59+01:00\",\"deliveryDays\":21},\"bike:flex-box\":{\"verifiedUntil\":\"2026-12-09T23:59:59+01:00\",\"deliveryDays\":21},\"bike:delight-box\":{\"verifiedUntil\":\"2026-12-09T23:59:59+01:00\",\"deliveryDays\":21},\"bike:delight-dog\":{\"verifiedUntil\":\"2026-12-09T23:59:59+01:00\",\"deliveryDays\":21},\"bike:classic\":{\"verifiedUntil\":\"2026-12-09T23:59:59+01:00\",\"deliveryDays\":21},\"bike:classic-dog\":{\"verifiedUntil\":\"2026-12-09T23:59:59+01:00\",\"deliveryDays\":21},\"bike:classic-box\":{\"verifiedUntil\":\"2026-12-09T23:59:59+01:00\",\"deliveryDays\":21},\"bike:longlite\":{\"verifiedUntil\":\"2026-12-09T23:59:59+01:00\",\"deliveryDays\":21},\"accessory:canopy\":{\"verifiedUntil\":\"2026-12-09T23:59:59+01:00\",\"deliveryDays\":21},\"accessory:1577-1\":{\"verifiedUntil\":\"2026-12-09T23:59:59+01:00\",\"deliveryDays\":21},\"accessory:lock\":{\"verifiedUntil\":\"2026-12-09T23:59:59+01:00\",\"deliveryDays\":21},\"accessory:canopy-high\":{\"verifiedUntil\":\"2026-12-09T23:59:59+01:00\",\"deliveryDays\":21},\"accessory:1521-30\":{\"verifiedUntil\":\"2026-12-09T23:59:59+01:00\",\"deliveryDays\":21},\"accessory:1521-37\":{\"verifiedUntil\":\"2026-12-09T23:59:59+01:00\",\"deliveryDays\":21},\"accessory:cover\":{\"verifiedUntil\":\"2026-12-09T23:59:59+01:00\",\"deliveryDays\":21},\"accessory:canopy-kindergarten\":{\"verifiedUntil\":\"2026-12-09T23:59:59+01:00\",\"deliveryDays\":21},\"accessory:1537-7\":{\"verifiedUntil\":\"2026-12-09T23:59:59+01:00\",\"deliveryDays\":21},\"accessory:1621\":{\"verifiedUntil\":\"2026-12-09T23:59:59+01:00\",\"deliveryDays\":21},\"accessory:1521-23\":{\"verifiedUntil\":\"2026-12-09T23:59:59+01:00\",\"deliveryDays\":21},\"accessory:1633\":{\"verifiedUntil\":\"2026-12-09T23:59:59+01:00\",\"deliveryDays\":21},\"accessory:1592-1\":{\"verifiedUntil\":\"2026-12-09T23:59:59+01:00\",\"deliveryDays\":21}}"
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "cargobajk.sk",
      "custom_domain": true
    },
    {
      "pattern": "www.cargobajk.sk/*",
      "zone_name": "cargobajk.sk"
    }
  ],
  "preview_urls": false,
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  }
}
