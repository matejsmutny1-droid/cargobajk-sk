{
  "name": "cargobajk-sk",
  "main": "worker.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "SHOP_DB",
      "database_name": "cargobajk-orders",
      "database_id": "96d6d5c1-ff9a-412e-80cb-deca2a7e20b2",
      "preview_database_id": "286406c3-7b40-46f3-bf75-1c4966596a3f",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "vars": {
    "SHOP_MODE": "off",
    "INQUIRY_FROM": "cargobajk.sk <hello@vividproduction.sk>",
    "INQUIRY_ALLOWED_ORIGINS": "https://cargobajk.sk,https://www.cargobajk.sk"
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "cargobajk.sk",
      "custom_domain": true
    },
    {
      "pattern": "www.cargobajk.sk/*",
      "zone_name": "cargobajk.sk"
    }
  ],
  "preview_urls": false,
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  }
}
