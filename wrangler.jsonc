{
  "name": "cargobajk-sk",
  "main": "worker.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "vars": {
    "INQUIRY_FROM": "cargobajk.sk <hello@vividproduction.sk>",
    "INQUIRY_ALLOWED_ORIGINS": "https://cargobajk.sk,https://www.cargobajk.sk"
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "cargobajk.sk",
      "custom_domain": true
    },
    {
      "pattern": "www.cargobajk.sk/*",
      "zone_name": "cargobajk.sk"
    }
  ],
  "preview_urls": false
}
