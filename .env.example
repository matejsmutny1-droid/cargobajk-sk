# Copy to .env.local for local development. Never commit real values.
RESEND_API_KEY=
# Only set after this sender's domain is verified in Resend:
INQUIRY_FROM=Cargobike Slovensko <hello@vividproduction.sk>
# Extra origins if your host forwards requests using an internal origin:
INQUIRY_ALLOWED_ORIGINS=https://cargobike-slovensko-navrh.stablelake16.chatgpt.site

# Online checkout: keep off until D1, Stripe, policies and product delivery are verified.
SHOP_MODE=off
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SHOP_POLICIES_VERSION=
# JSON maps product IDs to {verifiedUntil: ISO date, deliveryDays: number}.
SHOP_PRODUCTS_JSON={}
# Server-verified road routes only: [{postalCode,city,km,expiresAt}].
SHOP_ROUTES_JSON=[]
# Only products with verified parcel dimensions. Multiple-item parcels require a quote.
SHOP_PARCEL_IDS_JSON=[]
